# Copy to .env and fill in. Defaults run fully offline (hashing embedder + FakeLLM).

# Providers: REPOQA_EMBEDDER = hashing | openai ; REPOQA_LLM = fake | openai | anthropic
REPOQA_EMBEDDER=hashing
REPOQA_LLM=fake

# API keys (only needed for the matching provider)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Models
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-sonnet-5-5

# Retrieval and answering
REPOQA_TOP_K=6
REPOQA_MIN_SCORE=0.15
REPOQA_CITATION_MODE=strip

# Storage and indexing
REPOQA_HOME=.repoqa
REPOQA_MAX_FILE_BYTES=200000
# REPOQA_REPO=my-repo

# Provider calls: timeout, retries, client-side limits
REPOQA_TIMEOUT_S=60
REPOQA_MAX_RETRIES=4
REPOQA_MAX_CONCURRENCY=4
REPOQA_RPM=120

# HTTP server rate limit, per client IP
REPOQA_API_RPM=30
